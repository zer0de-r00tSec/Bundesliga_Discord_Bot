# ── Discord ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_token_here
DISCORD_GUILD_ID=123456789012345678
# "Die Konferenz": alle Spiele 1. + 2. Liga (Anpfiff, Tore, Halbzeit, Endstand, Tabellen)
DISCORD_TICKER_CHANNEL_ID=123456789012345678
# Optional: eigener Konferenz-Channel pro Liga (leer/0 = Ticker-Channel)
DISCORD_TICKER_CHANNEL_BL1=0
DISCORD_TICKER_CHANNEL_BL2=0
# Optional: weitere Ligen fest per ID, z.B. dfb:123,ffb1:456 (sonst legt der Bot sie an, siehe unten)
DISCORD_TICKER_CHANNELS=
# 0 = aus. Wenn gesetzt, muss im Developer-Portal "Server Members Intent" an sein!
DISCORD_WELCOME_CHANNEL_ID=0
# Kommagetrennt oder JSON-Liste. Server-Admins dürfen Admin-Commands immer.
DISCORD_ADMIN_USER_IDS=123456789012345678
# Rolle, die jedes neue Mitglied automatisch bekommt (0 = aus).
# Nötig: Bot-Recht "Rollen verwalten", Bot-Rolle ÜBER dieser Rolle, im Developer-Portal "Server Members Intent" an
DISCORD_AUTO_ROLE_ID=0

# ── MariaDB ──────────────────────────────────────────────
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=football_bot
MARIADB_USER=football_bot
MARIADB_PASSWORD=sicheres_passwort

# ── App ──────────────────────────────────────────────────
# 0 = automatisch (ab Juli neue Saison). OpenLigaDB: Saison 2026/27 = 2026
SEASON=0
# bl1/bl2 Herren, dfb = DFB-Pokal, ffb1 = Frauen-Bundesliga, dfbf = DFB-Pokal Frauen
LEAGUES=bl1,bl2,dfb,ffb1,dfbf
TIMEZONE=Europe/Berlin
POLL_INTERVAL_LIVE_SECONDS=15
PRE_KICKOFF_WAKE_MINUTES=30
MATCH_MAX_DURATION_MINUTES=180
FULL_SYNC_INTERVAL_HOURS=12
CONFERENCE_ENABLED=true
POST_TABLE_AFTER_MATCHDAY=true
POST_MATCHDAY_OPENER=true

# ── Automatische Channels (Bot-Recht "Kanäle verwalten" nötig) ──
# Je Liga eine Kategorie mit einem Channel pro Spiel, wird jeden Spieltag neu gebaut (leer = aus)
MATCH_CHANNEL_LEAGUES=bl1,bl2
MATCH_CATEGORY_NAMES=bl1:Bundesliga 1,bl2:Bundesliga 2,ffb1:Frauen-Bundesliga
# so viele Stunden vor dem ersten Anstoß eines Spieltags werden die neuen Channels angelegt
MATCH_CHANNEL_PREPARE_HOURS=24
MATCH_CHANNEL_SEPARATOR=-vs-
MATCH_CHANNEL_STATUS_EMOJI=true
MATCH_CHANNEL_CLEANUP=true
# Konferenz-Channels, die der Bot selbst anlegt (in der Kategorie von DISCORD_TICKER_CHANNEL_ID)
CONFERENCE_CHANNEL_NAMES=dfb:dfb-pokal,ffb1:frauen-bundesliga,dfbf:frauen-bundesliga
AUTO_CREATE_CONFERENCE_CHANNELS=true

LOG_LEVEL=INFO
# Datei-Log log/bot.log – DEBUG = alles mitschreiben
LOG_FILE_LEVEL=DEBUG
# leer = <projekt>/log
LOG_DIR=
